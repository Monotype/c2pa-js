{
  "compilerOptions": {
    "outDir": "pkg/types",
    "lib": ["ESNext"],
    "emitDeclarationOnly": true,
    "declaration": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["types/**/*"],
  "exclude": ["node_modules", "../../../node_modules"]
}
