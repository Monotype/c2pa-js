{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "jsx": "react",
    "module": "ES6",
    "moduleResolution": "node",
    "strict": true,
    "target": "ES6",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"] // Explicitly resolve @types/node locally
  },
  "include": ["**/*"],
  "exclude": ["dist", "node_modules"] // Ensure node_modules is excluded to avoid conflicts
}
